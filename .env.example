# PaperLens 环境变量示例
# 使用方法：把本文件复制一份，改名为 .env，然后填入你自己的真实密钥。
# 注意：.env 已被 .gitignore 忽略，不会被提交到 GitHub。

# 模型服务的 API Key（必填，否则页面会提示未配置，不会生成真实 AI 结果）
# 支持 OpenAI 兼容接口（如 OpenAI、DeepSeek、Moonshot、通义等）
LLM_API_KEY=在这里填入你的API密钥

# 模型服务的接口地址（OpenAI 兼容的 chat/completions 地址）
# 例如 DeepSeek: https://api.deepseek.com/v1/chat/completions
# 例如 OpenAI:   https://api.openai.com/v1/chat/completions
LLM_BASE_URL=https://api.deepseek.com/v1/chat/completions

# 使用的模型名称
LLM_MODEL=deepseek-chat

# 本地服务端口（一般不用改）
PORT=3000
